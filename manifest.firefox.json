{
  "manifest_version": 2,
  "name": "SimpleOne Plugin by Terekhov",
  "version": "1.5.5",
  "description": "Позволяет кастомизировать S1 и его отдельные элементы",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://sd.jet.su/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Настройки плагина"
  },
  "content_scripts": [
    {
      "matches": ["https://sd.jet.su/list/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "icons": {
    "16": "icon/icon16.png",
    "48": "icon/icon48.png",
    "128": "icon/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "simpleone-plugin@terekhov.com",
      "strict_min_version": "91.0"
    }
  }
}