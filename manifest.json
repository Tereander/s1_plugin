{
  "manifest_version": 3,
  "name": "SimpleOne Plugin by Terekhov",
  "version": "1.7.2",
  "description": "Позволяет кастомизировать S1 и его отдельные элементы",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://sd.jet.su/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Настройки плагина"
  },
  "content_scripts": [
    {
      "matches": ["https://sd.jet.su/list/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://sd.jet.su/record/*"],
      "js": ["activity_fetcher.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://sd.jet.su/record/itsm_infosys_task/*", "https://sd.jet.su/record/itsm_infosys_order/*"],
      "js": ["deferred-styler.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["activity_fetcher.js"],
      "matches": ["https://sd.jet.su/*"]
    }
  ],
  "icons": {
    "16": "icon/icon16.png",
    "48": "icon/icon48.png",
    "128": "icon/icon128.png"
  }
}