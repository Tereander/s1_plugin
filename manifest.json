{
  "manifest_version": 3,
  "name": "SimpleOne Color Plugin",
  "version": "1.8.1",
  "description": "Позволяет кастомизировать S1 и его отдельные элементы. By Terekhov",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://sd.jet.su/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Настройки плагина"
  },
  "content_scripts": [
    {
      "matches": ["https://sd.jet.su/*"],
      "js": ["content.js", "activity_fetcher.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["activity_fetcher.js"],
      "matches": ["https://sd.jet.su/*"]
    }
  ],
  "icons": {
    "16": "icon/icon16.png",
    "64": "icon/icon64.png",
    "128": "icon/icon128.png"
  }
}