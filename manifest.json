{
  "manifest_version": 3,
  "name": "SimpleOne Plugin by Terekhov",
  "version": "1.4.1",
  "description": "Позволяет кастомизировать S1 и его отдельные элементы",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Настройки плагина"
  },
  "content_scripts": [
    {
      "matches": ["https://sd.jet.su/list/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}